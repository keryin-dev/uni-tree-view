{
  "name": "uni-tree-view",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@11.27.1",
  "description": "适用于 uni-app 与 Vue 3 的跨平台树形组件，支持单选、多选、筛选、懒加载和虚拟列表",
  "author": "keryin-dev <415561402@qq.com>",
  "license": "MIT",
  "homepage": "https://uni-tree-view.keryin.top/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keryin-dev/uni-tree-view.git"
  },
  "bugs": "https://github.com/keryin-dev/uni-tree-view/issues",
  "keywords": [
    "uni-tree-view",
    "uni-app",
    "uniapp",
    "uniapp-tree",
    "vue",
    "vue3",
    "component",
    "tree",
    "tree-view",
    "tree-component",
    "tree-select",
    "tree-selection",
    "selection",
    "checkbox",
    "lazy-loading",
    "virtual-list",
    "mini-program",
    "wechat-mini-program",
    "alipay-mini-program",
    "h5",
    "dcloud"
  ],
  "sideEffects": [
    "./src/components/**/*.vue"
  ],
  "exports": {
    ".": {
      "types": "./src/components/uni-tree-view/uni-tree-view.vue.d.ts",
      "import": "./src/components/uni-tree-view/uni-tree-view.vue"
    },
    "./shared": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js"
    },
    "./resolver": {
      "types": "./dist-resolver/index.d.ts",
      "import": "./dist-resolver/index.mjs",
      "require": "./dist-resolver/index.cjs"
    },
    "./global": "./src/global.d.ts"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "dist-resolver",
    "src"
  ],
  "scripts": {
    "build": "nr clean:dist && unbuild && tsx scripts/post-build.ts",
    "clean:dist": "rimraf ./dist ./dist-resolver",
    "lint:type": "vue-tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p tsconfig.node.json",
    "prepack": "pnpm -w changelog:package"
  },
  "peerDependencies": {
    "vue": ">=3.3.0 <4"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@uni-helper/vite-plugin-uni-components": "catalog:build",
    "@vue/runtime-core": "catalog:dev",
    "tsx": "catalog:script",
    "typescript": "catalog:dev",
    "vue": "catalog:frontend",
    "vue-tsc": "catalog:dev"
  }
}