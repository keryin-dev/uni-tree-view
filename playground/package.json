{
  "name": "@uni-tree-view/playground",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.27.1",
  "description": "uni-tree-view 跨平台示例与开发调试工程",
  "author": "keryin-dev <415561402@qq.com>",
  "license": "MIT",
  "keywords": [
    "uni-tree-view",
    "playground"
  ],
  "main": "index.js",
  "scripts": {
    "dev:h5": "uni --port 9861",
    "dev:h5:ssr": "uni --ssr",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:mp-baidu": "uni -p mp-baidu",
    "dev:mp-jd": "uni -p mp-jd",
    "dev:mp-kuaishou": "uni -p mp-kuaishou",
    "dev:mp-lark": "uni -p mp-lark",
    "dev:mp-qq": "uni -p mp-qq",
    "dev:mp-toutiao": "uni -p mp-toutiao",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-xhs": "uni -p mp-xhs",
    "dev:quickapp-webview": "uni -p quickapp-webview",
    "dev:quickapp-webview-huawei": "uni -p quickapp-webview-huawei",
    "dev:quickapp-webview-union": "uni -p quickapp-webview-union",
    "build:h5": "uni build",
    "build:h5:docs": "uni build --mode docs --outDir ../docs/public/ui",
    "build:h5:ssr": "uni build --ssr",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:mp-baidu": "uni build -p mp-baidu",
    "build:mp-jd": "uni build -p mp-jd",
    "build:mp-kuaishou": "uni build -p mp-kuaishou",
    "build:mp-lark": "uni build -p mp-lark",
    "build:mp-qq": "uni build -p mp-qq",
    "build:mp-toutiao": "uni build -p mp-toutiao",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-xhs": "uni build -p mp-xhs",
    "build:quickapp-webview": "uni build -p quickapp-webview",
    "build:quickapp-webview-huawei": "uni build -p quickapp-webview-huawei",
    "build:quickapp-webview-union": "uni build -p quickapp-webview-union",
    "lint:type": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@dcloudio/uni-app": "catalog:prod",
    "@dcloudio/uni-app-harmony": "catalog:prod",
    "@dcloudio/uni-app-plus": "catalog:prod",
    "@dcloudio/uni-components": "catalog:prod",
    "@dcloudio/uni-h5": "catalog:prod",
    "@dcloudio/uni-mp-alipay": "catalog:prod",
    "@dcloudio/uni-mp-baidu": "catalog:prod",
    "@dcloudio/uni-mp-jd": "catalog:prod",
    "@dcloudio/uni-mp-kuaishou": "catalog:prod",
    "@dcloudio/uni-mp-lark": "catalog:prod",
    "@dcloudio/uni-mp-qq": "catalog:prod",
    "@dcloudio/uni-mp-toutiao": "catalog:prod",
    "@dcloudio/uni-mp-weixin": "catalog:prod",
    "@dcloudio/uni-mp-xhs": "catalog:prod",
    "@dcloudio/uni-quickapp-webview": "catalog:prod",
    "@wot-ui/ui": "catalog:prod",
    "lodash-es": "catalog:utils",
    "uni-tree-view": "workspace:*",
    "vue": "catalog:frontend"
  },
  "devDependencies": {
    "@dcloudio/types": "catalog:dev",
    "@dcloudio/uni-cli-shared": "catalog:dev",
    "@dcloudio/uni-stacktracey": "catalog:dev",
    "@dcloudio/vite-plugin-uni": "catalog:build",
    "@mini-types/alipay": "catalog:dev",
    "@types/lodash-es": "catalog:types",
    "@types/node": "catalog:types",
    "@uni-helper/uni-app-types": "catalog:dev",
    "@vue/runtime-core": "catalog:dev",
    "@xiaohe01/tsconfig": "catalog:dev",
    "miniprogram-api-typings": "catalog:dev",
    "sass": "catalog:style",
    "typescript": "catalog:dev",
    "vite": "catalog:build",
    "vue-tsc": "catalog:dev"
  }
}